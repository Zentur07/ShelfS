# OPTIONAL manual configuration only. For automatic PostgreSQL + Mailpit, run start.cmd without copying this file.
# Replace all examples with your own private settings.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SITE_URL=http://127.0.0.1:8000
DB_ENGINE=sqlite
# For PostgreSQL, set DB_ENGINE=postgresql and fill the fields below.
DB_NAME=shelfs
DB_USER=shelfs
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
# SECRET_KEY must be a random secret when DEBUG=0.
SECRET_KEY=
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=library@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
RESERVATION_HOURS=48
LOAN_DAYS=14
REMINDER_DAYS=2
OVERDUE_REPEAT_DAYS=3

EMAIL_USE_SSL=0
LOCAL_SERVICES=0
TRUST_PROXY=0
CSRF_TRUSTED_ORIGINS=
